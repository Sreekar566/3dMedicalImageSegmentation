# ==============================================================================
# 3dMedicalImageSegmentation Configuration
# ==============================================================================

# --- Azure Blob Storage Settings ---
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_NAME="your_storage_account"
AZURE_STORAGE_ACCOUNT_KEY="your_account_key"
AZURE_STORAGE_INPUT_CONTAINER="medical-volumes-input"
AZURE_STORAGE_OUTPUT_CONTAINER="medical-segmentations-output"
AZURE_STORAGE_MAX_CONCURRENCY=4
AZURE_STORAGE_TIMEOUT_SECONDS=300

# --- Azure Database for PostgreSQL Settings ---
DB_HOST="your-azure-db.postgres.database.azure.com"
DB_PORT=5432
DB_NAME="medical_imaging"
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
DB_SSLMODE="require"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_BATCH_SIZE=500

# --- Volumetric Model & Inference Settings ---
INFERENCE_MODALITY="CT"                          # Options: CT, CBCT, MRI
INFERENCE_TARGET_ORIENTATION="RAS"              # SimpleITK DICOMOrient standard: RAS or LPS
INFERENCE_ROI_SIZE="(96, 96, 96)"               # 3D sliding window patch dimensions
INFERENCE_SW_BATCH_SIZE=2
INFERENCE_OVERLAP=0.5
INFERENCE_IN_CHANNELS=1
INFERENCE_OUT_CHANNELS=2
INFERENCE_MODEL_CHECKPOINT_PATH=""              # Path to pre-trained .pt/.pth weights
INFERENCE_DEVICE="cuda"                         # Options: cuda, mps, cpu

# --- Runtime Logging & Workspace ---
LOG_LEVEL="INFO"                                 # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="text"                                # Options: text, json (for cloud aggregators)
LOG_FILE=""                                      # Optional local file destination for logs
WORK_DIR="/tmp/medical_segmentation_workspace"
